@model List<Departamento>

<h1 style="color:blue">
    Departamentos
</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id Departamento</th>
            <th>Nombre</th>
            <th>Localidad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach ( Departamento dept in Model )
        {
            <tr>
                <td>@dept.IdDepartamento</td>
                <td>@dept.Nombre</td>
                <td>@dept.Localidad</td>
                <td>
                    <a asp-controller="Departamentos" asp-action="Details" asp-route-id="@dept.IdDepartamento" class="btn btn-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>