@model Departamento

<h1 style="color:red">
    Details Departamento
</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id Departamento</th>
            <th>Nombre</th>
            <th>Localidad</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.IdDepartamento</td>
            <td>@Model.Nombre</td>
            <td>@Model.Localidad</td>
        </tr>
    </tbody>
</table>